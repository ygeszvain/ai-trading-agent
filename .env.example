# trading-agent environment example.
#
# Copy to `.env` (gitignored) and fill in values. This file must never contain
# real secrets. Only the environment variables listed below are read; anything
# else is ignored by the configuration loader.
#
TRADING_MODE=simulation
LIVE_TRADING_ENABLED=false
LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL_ID=
LM_STUDIO_API_TOKEN=
LLM_ALLOW_CLOUD_FALLBACK=false

# Optional: path to an alternate configuration file (default: config/simulation.yaml)
#TRADING_AGENT_CONFIG=

# Optional: local website bind (loopback only; must not conflict with LM Studio)
#TRADING_AGENT_WEB_HOST=127.0.0.1
#TRADING_AGENT_WEB_PORT=8000

# Optional: Dockerized local database password (compose falls back to trust auth)
#TRADING_AGENT_PG_PASSWORD=
